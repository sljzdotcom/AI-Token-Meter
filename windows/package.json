{
  "name": "ai-token-meter-windows",
  "private": true,
  "version": "0.3.0-preview.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:density": "vite build --config vite.density.config.ts",
