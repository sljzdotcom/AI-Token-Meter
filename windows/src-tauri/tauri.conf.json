{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Token Meter",
  "version": "0.3.0-preview.1",
  "identifier": "com.millerpan.aitokenmeter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "meter",
        "title": "AI Token Meter",
        "width": 116,
        "height": 450,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "detail",
        "title": "AI Token Meter Details",
        "width": 440,
        "height": 760,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "AI Token Meter Settings",
        "width": 760,
        "height": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3MDdENjkwMzhFNzQ5RUUKUldUdVNlYzRrTllIMTNoMFNrb1dKSWpud2JQRXk3S2p3dm56ak84eXlqRkJJblh2aCs3Q1dsSE0K",
      "endpoints": [
        "https://github.com/sljzdotcom/AI-Token-Meter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
